    {
      "name": "TS-001 Health & COOP/COEP Security Headers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('COOP/COEP/CORP & hardening headers present', function () {",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Opener-Policy')).to.eql('same-origin');",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Embedder-Policy')).to.eql('require-corp');",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Resource-Policy')).to.eql('same-origin');",
              "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
              "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
              "});",
              "pm.test('Health payload reports wasmDspReady', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.wasmDspReady).to.eql(true);",
              "  pm.expect(body.profiles).to.include('modern_pop_polish');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
