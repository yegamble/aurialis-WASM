{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/**/__tests__/*.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "scripts/*.mjs",
    "scripts/qualification/*.mjs",
    "e2e/album-scale*.cases.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": [
    "newman",
    "tailwindcss"
  ],
  "ignoreBinaries": [
    "python3"
  ]
}
