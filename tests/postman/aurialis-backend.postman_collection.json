          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('V2 is bound to canonical source and neutral coverage', function () { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.status).to.eql('done'); const script=body.scriptV2; pm.expect(script.version).to.eql('2.0'); pm.expect(script.source.pcmHash).to.match(/^[0-9a-f]{64}$/); pm.expect(script.source.frames).to.eql(19200); pm.expect(script.sections[0].roleHint).to.eql('unknown'); pm.expect(script.sections.at(-1).endFrame).to.eql(19200); pm.collectionVariables.set('deepV2Script',JSON.stringify(script)); const stale=JSON.parse(JSON.stringify(script)); stale.source.pcmHash='0'.repeat(64); pm.collectionVariables.set('staleV2Script',JSON.stringify(stale)); });"
