    {
      "name": "TS-017 Verify Source-Bound Neutral Measured Features",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Feature job returns measured source and neutral coverage', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('done');",
              "  pm.expect(body.script).to.eql(undefined);",
              "  const features = body.features;",
              "  pm.expect(features.version).to.eql('1.0');",
              "  pm.expect(features.source.pcmHash).to.match(/^[0-9a-f]{64}$/);",
              "  pm.expect(features.source.sampleRate).to.eql(48000);",
              "  pm.expect(features.source.frames).to.eql(19200);",
              "  pm.expect(features.bands).to.have.lengthOf(5);",
              "  pm.expect(features.frames).to.have.lengthOf(1);",
              "  pm.expect(features.sections).to.have.lengthOf(1);",
              "  pm.expect(features.sections[0].name).to.eql('Section 1');",
              "  pm.expect(features.sections[0].roleHint).to.eql('unknown');",
              "  pm.expect(features.sections[0].startFrame).to.eql(0);",
              "  pm.expect(features.sections[0].endFrame).to.eql(19200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/jobs/{{featureJobId}}?wait=1"
      }
