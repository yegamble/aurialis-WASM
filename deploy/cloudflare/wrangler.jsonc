{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production Worker. `main` deploys it from CI; pull requests get isolated
  // Worker Previews (`wrangler preview --name pr-<number>`) on workers.dev.
  "name": "aurialis-wasm",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  // Production is reachable only through its custom domains, so no second
  // public origin exists. Preview URLs are configured separately and stay on.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "aurialis.yosefgamble.com", "custom_domain": true },
    { "pattern": "aurialis.yosef.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
