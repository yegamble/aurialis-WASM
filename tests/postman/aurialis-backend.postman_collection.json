{
  "info": {
    "name": "Aurialis-WASM Backend API & Security Suite (TS-001 to TS-015)",
    "_postman_id": "a7b8c9d0-1234-4567-89ab-cdef01234567",
    "description": "Comprehensive Newman API, DSP, Audio CDR, and security verification suite for the Aurialis-WASM Go binary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18765"
    },
    {
      "key": "validWavPath",
      "value": ""
    },
    {
      "key": "spoofPdfPath",
      "value": ""
    },
    {
      "key": "sepJobId",
      "value": ""
    },
    {
      "key": "deepJobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "TS-001 Health & COOP/COEP Security Headers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('COOP/COEP/CORP & hardening headers present', function () {",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Opener-Policy')).to.eql('same-origin');",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Embedder-Policy')).to.eql('require-corp');",
              "  pm.expect(pm.response.headers.get('Cross-Origin-Resource-Policy')).to.eql('same-origin');",
              "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
              "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
              "});",
              "pm.test('Health payload reports wasmDspReady', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.wasmDspReady).to.eql(true);",
              "  pm.expect(body.profiles).to.include('modern_pop_polish');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "TS-002 Serve Embedded WASM Binary with application/wasm",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 and Content-Type is application/wasm', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/wasm');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wasm/aurialis-dsp.wasm"
      }
    },
    {
      "name": "TS-003 Serve AudioWorklet Processor Script",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 and Content-Type is javascript', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('javascript');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/worklets/aurialis-dsp-worklet.js"
      }
    },
    {
      "name": "TS-004 POST /separate (4 Stems Happy Path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 202', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Returns jobId and job_id', function () {",
              "  pm.expect(body.jobId).to.be.a('string');",
              "  pm.expect(body.job_id).to.eql(body.jobId);",
              "  pm.collectionVariables.set('sepJobId', body.jobId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{validWavPath}}"
            },
            {
              "key": "stems",
              "value": "4",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/separate"
      }
    },
    {
      "name": "TS-005 GET /jobs/:id/result (Wait & Verify 4 Stems)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Stem job completed with 4 stems', function () {",
              "  pm.expect(body.status).to.be.oneOf(['done', 'completed']);",
              "  pm.expect(body.stems.length).to.eql(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jobs/{{sepJobId}}/result?wait=1"
      }
    },
    {
      "name": "TS-006 GET /jobs/:id/stems/vocals (Download Re-Synthesized Stem WAV)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 audio/wav', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('audio/wav');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jobs/{{sepJobId}}/stems/vocals"
      }
    },
    {
      "name": "TS-007 POST /analyze/deep & Verify MasteringScript v1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 202', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
              "});",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('deepJobId', body.jobId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{validWavPath}}"
            },
            {
              "key": "profile",
              "value": "modern_pop_polish",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/analyze/deep"
      }
    },
    {
      "name": "TS-007b GET /jobs/:id/result (Verify MasteringScript v1 Schema)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 and script version is 1', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.be.oneOf(['done', 'completed']);",
              "  pm.expect(String(body.script.version)).to.be.oneOf(['1', '1.0']);",
              "  pm.expect(body.script.sections.length).to.be.above(0);",
              "  pm.expect(body.script.moves.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jobs/{{deepJobId}}/result?wait=1"
      }
    },
    {
      "name": "TS-008 POST /api/master/render (Synchronous 24-bit WAV Render)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 audio/wav with loudness headers', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('audio/wav');",
              "  pm.expect(pm.response.headers.get('X-Aurialis-After-LUFS')).to.be.a('string');",
              "  pm.expect(pm.response.headers.get('X-Aurialis-After-Peak-dBTP')).to.be.a('string');",
              "});",
              "pm.test('WAV contains source-length real PCM frames', function () {",
              "  const bytes = pm.response.stream;",
              "  pm.expect(bytes.length).to.eql(44 + 19200 * 6);",
              "  pm.expect(String.fromCharCode(...Array.from(bytes.slice(0,4)))).to.eql('RIFF');",
              "  pm.expect(String.fromCharCode(...Array.from(bytes.slice(8,12)))).to.eql('WAVE');",
              "  pm.expect(bytes[34] + bytes[35] * 256).to.eql(24);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{validWavPath}}"
            },
            {
              "key": "bitDepth",
              "value": "24",
              "type": "text"
            },
            {
              "key": "params",
              "value": "{\"inputGainDb\":2.5,\"limiter\":{\"enabled\":true,\"ceilingDb\":-1.0,\"targetLufs\":-14.0,\"releaseMs\":85,\"truePeak\":true}}",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/master/render"
      }
    },
